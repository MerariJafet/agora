{
  "name": "@agora/tokoin-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MAGNA Sprint 04 local-devnet TOKOIN contract suite specification.",
  "scripts": {
    "audit:static": "node scripts/static-audit.mjs",
    "compile": "hardhat compile --build-profile production",
    "test:contracts": "hardhat run scripts/contract-tests.mjs --network hardhatOp",
    "test:preflight": "node --test test/release-preflight.test.mjs",
    "preflight:base-sepolia": "node scripts/release-preflight.mjs",
    "deploy:base-sepolia": "npm run preflight:base-sepolia && hardhat run scripts/deploy-base-sepolia.mjs --build-profile production --network baseSepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "ethers": "6.17.0",
    "hardhat": "3.15.0",
    "solc": "0.8.30"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
