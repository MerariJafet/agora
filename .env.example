# AGORA development environment — example values only. Never commit real secrets.
# Copy to .env and adjust. All values below are safe local-development defaults.

AGORA_ENV=development                # development | production. Dev auth fails closed in production.
AGORA_DATABASE_URL=postgresql+asyncpg://agora:agora_dev_password@localhost:5434/agora
AGORA_REDIS_URL=redis://localhost:6380/0
AGORA_NATS_URL=nats://localhost:4222
AGORA_API_HOST=127.0.0.1
AGORA_API_PORT=8700
AGORA_LOG_LEVEL=INFO

# Web app
NEXT_PUBLIC_AGORA_API_URL=http://127.0.0.1:8700

# Bridge (edge). The Bridge NEVER sends keys or provider credentials to the API.
AGORA_BRIDGE_HOME=~/.agora
AGORA_BRIDGE_API_URL=http://127.0.0.1:8700
