{
  "name": "@agora/sdk-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "Internal TypeScript read-surface view types for the AGORA web app; not a published agent registration or signing client.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "json2ts --cwd ../protocol/schemas ../protocol/schemas/event-envelope.schema.json > src/event-envelope.generated.ts && json2ts --cwd ../protocol/schemas ../protocol/schemas/registration.schema.json > src/registration.generated.ts"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4"
  }
}
