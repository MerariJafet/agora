{
  "$id": "research-protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGORA Research Protocol v1 wire contracts",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "RegisterInstitutionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_entity_id", "name", "domain", "jurisdiction", "signing_public_key", "credential_reference", "credential_hash"],
      "properties": {
        "legal_entity_id": {"type": "string", "minLength": 3, "maxLength": 160},
        "name": {"type": "string", "minLength": 2, "maxLength": 200},
        "domain": {"type": "string", "pattern": "^[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$", "maxLength": 253},
        "jurisdiction": {"type": "string", "minLength": 2, "maxLength": 80},
        "signing_public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "credential_reference": {"type": "string", "minLength": 8, "maxLength": 500},
        "credential_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "payout_address": {"type": "string", "minLength": 8, "maxLength": 128},
        "conflict_metadata": {"type": "object", "additionalProperties": true, "maxProperties": 20}
      }
    },
    "VerifyInstitutionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_evidence_hash"],
      "properties": {
        "verification_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "CreateCandidateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submission_id", "final_solution_object_id", "idempotency_key"],
      "properties": {
        "submission_id": {"type": "string", "minLength": 1, "maxLength": 30},
        "final_solution_object_id": {"type": "string", "minLength": 1, "maxLength": 30},
        "manuscript_artifact_version_id": {"type": "string", "minLength": 1, "maxLength": 30},
        "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128}
      }
    },
    "InstitutionalVerdict": {
      "type": "string",
      "enum": ["APPROVED", "APPROVED_WITH_MINOR_CHANGES", "REQUIRES_REVISION", "REJECTED", "INSUFFICIENT_EVIDENCE"]
    },
    "CreateInstitutionalReviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institution_id", "verdict", "methodology_review", "evidence_review", "paper_review", "experiment_review", "conflict_declaration", "signature"],
      "properties": {
        "institution_id": {"type": "string", "minLength": 1, "maxLength": 30},
        "verdict": {"$ref": "#/$defs/InstitutionalVerdict"},
        "methodology_review": {"type": "string", "minLength": 20, "maxLength": 20000},
        "evidence_review": {"type": "string", "minLength": 20, "maxLength": 20000},
        "paper_review": {"type": "string", "minLength": 20, "maxLength": 20000},
        "experiment_review": {"type": "string", "minLength": 20, "maxLength": 20000},
        "conflict_declaration": {"type": "string", "minLength": 5, "maxLength": 5000},
        "signature": {"type": "string", "minLength": 80, "maxLength": 128}
      }
    },
    "PrepareInstitutionalReviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institution_id", "verdict", "methodology_review", "evidence_review", "paper_review", "experiment_review", "conflict_declaration"],
      "properties": {
        "institution_id": {"type": "string", "minLength": 1, "maxLength": 30},
        "verdict": {"$ref": "#/$defs/InstitutionalVerdict"},
        "methodology_review": {"type": "string", "minLength": 20, "maxLength": 20000},
        "evidence_review": {"type": "string", "minLength": 20, "maxLength": 20000},
        "paper_review": {"type": "string", "minLength": 20, "maxLength": 20000},
        "experiment_review": {"type": "string", "minLength": 20, "maxLength": 20000},
        "conflict_declaration": {"type": "string", "minLength": 5, "maxLength": 5000}
      }
    },
    "CalculateRewardRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_aceros"],
      "properties": {
        "total_aceros": {"type": "integer", "minimum": 100, "maximum": 1000000000000}
      }
    },
    "RegisterPilotValidatorRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "institution_name", "institution_type", "legal_entity_id", "domain", "jurisdiction", "institution_mode", "accreditation_status", "public_label", "brain_provider", "review_role", "scientific_domains"],
      "properties": {
        "display_name": {"type": "string", "minLength": 3, "maxLength": 120},
        "institution_name": {"type": "string", "minLength": 3, "maxLength": 200},
        "institution_type": {"type": "string", "enum": ["synthetic_university_lab", "synthetic_research_institute"]},
        "legal_entity_id": {"type": "string", "pattern": "^TEST-LEGAL-[A-Z0-9-]+$", "maxLength": 160},
        "domain": {"type": "string", "pattern": "^[A-Za-z0-9.-]+\\.example\\.org$", "maxLength": 253},
        "jurisdiction": {"const": "TEST"},
        "institution_mode": {"const": "simulated_test"},
        "accreditation_status": {"const": "NOT_REAL"},
        "public_label": {"const": "Institución simulada para pruebas de AGORA"},
        "brain_provider": {"type": "string", "enum": ["codex", "claude", "python-scripted-test"]},
        "review_role": {"type": "string", "enum": ["REPRODUCTION_METHODOLOGY", "FALSIFICATION_EVIDENCE"]},
        "scientific_domains": {
          "type": "array",
          "items": {"type": "string", "minLength": 2, "maxLength": 80},
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        }
      }
    },
    "AssignPilotValidatorsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_ids"],
      "properties": {
        "validator_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 30},
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "PilotOwnerRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment", "rationale", "blocking_issues", "what_is_missing", "suggested_actions"],
      "properties": {
        "assessment": {"type": "string", "enum": ["PASS", "PASS_WITH_CONDITIONS", "FAIL", "INSUFFICIENT_EVIDENCE"]},
        "rationale": {"type": "string", "minLength": 20, "maxLength": 20000},
        "blocking_issues": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "maxItems": 50},
        "what_is_missing": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "maxItems": 50},
        "suggested_actions": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "maxItems": 50}
      }
    },
    "PilotEvidenceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_hash", "participant_ids", "thread_entry_ids", "event_ids", "artifact_ids", "test_receipt_hashes"],
      "properties": {
        "context_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "participant_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}, "maxItems": 200, "uniqueItems": true},
        "thread_entry_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}, "maxItems": 500, "uniqueItems": true},
        "event_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}, "maxItems": 500, "uniqueItems": true},
        "artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}, "maxItems": 200, "uniqueItems": true},
        "test_receipt_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "maxItems": 100, "uniqueItems": true}
      }
    },
    "PilotTokoinRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denomination", "total_aceros", "allocations", "synthetic_test_only", "settlement_eligible", "requires_separate_human_validation"],
      "properties": {
        "denomination": {"const": "ACEROS"},
        "total_aceros": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "allocations": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["recipient_kind", "recipient_id", "amount_aceros", "basis"],
            "properties": {
              "recipient_kind": {"type": "string", "enum": ["AGENT", "TEAM", "TEST_VALIDATOR_CREDIT", "INFRASTRUCTURE", "RESERVE"]},
              "recipient_id": {"type": "string", "minLength": 1, "maxLength": 160},
              "amount_aceros": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
              "basis": {"type": "string", "minLength": 10, "maxLength": 2000}
            }
          }
        },
        "synthetic_test_only": {"const": true},
        "settlement_eligible": {"const": false},
        "requires_separate_human_validation": {"const": true}
      }
    },
    "ActivatePilotValidatorRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_evidence_hash"],
      "properties": {
        "verification_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "CommitPilotReviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment_hash", "commitment_signature", "conflict_declaration"],
      "properties": {
        "commitment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "commitment_signature": {"type": "string", "minLength": 80, "maxLength": 128},
        "conflict_declaration": {"type": "string", "minLength": 5, "maxLength": 5000}
      }
    },
    "DeclarePilotConflictRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_declaration"],
      "properties": {
        "conflict_declaration": {"type": "string", "minLength": 10, "maxLength": 5000}
      }
    },
    "PilotReviewDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_validity", "methodology", "evidence", "reproducibility", "falsifiability", "statistics", "code_integrity", "data_integrity", "literature_alignment", "claim_scope"],
      "properties": {
        "question_validity": {"type": "integer", "minimum": 1, "maximum": 5},
        "methodology": {"type": "integer", "minimum": 1, "maximum": 5},
        "evidence": {"type": "integer", "minimum": 1, "maximum": 5},
        "reproducibility": {"type": "integer", "minimum": 1, "maximum": 5},
        "falsifiability": {"type": "integer", "minimum": 1, "maximum": 5},
        "statistics": {"type": "integer", "minimum": 1, "maximum": 5},
        "code_integrity": {"type": "integer", "minimum": 1, "maximum": 5},
        "data_integrity": {"type": "integer", "minimum": 1, "maximum": 5},
        "literature_alignment": {"type": "integer", "minimum": 1, "maximum": 5},
        "claim_scope": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "RevealPilotReviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment_nonce", "verdict", "confidence", "reproduction_status", "dimensions", "summary", "methodology_findings", "reproduction_findings", "evidence_findings", "critical_issues", "minor_issues", "requested_changes", "executed_tests", "artifacts_reviewed"],
      "properties": {
        "commitment_nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
        "verdict": {"$ref": "#/$defs/InstitutionalVerdict"},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
        "reproduction_status": {"type": "string", "enum": ["REPRODUCED", "PARTIALLY_REPRODUCED", "FAILED_TO_REPRODUCE", "NOT_REPRODUCIBLE_FROM_PROVIDED_ARTIFACTS", "NOT_REPRODUCED_DUE_TO_TOOL_LIMITATION", "NOT_APPLICABLE"]},
        "dimensions": {"$ref": "#/$defs/PilotReviewDimensions"},
        "summary": {"type": "string", "minLength": 20, "maxLength": 20000},
        "methodology_findings": {"type": "string", "minLength": 20, "maxLength": 20000},
        "reproduction_findings": {"type": "string", "minLength": 20, "maxLength": 20000},
        "evidence_findings": {"type": "string", "minLength": 20, "maxLength": 20000},
        "critical_issues": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "maxItems": 50},
        "minor_issues": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "maxItems": 50},
        "requested_changes": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "maxItems": 50},
        "executed_tests": {"type": "array", "items": {"type": "string", "maxLength": 2000}, "minItems": 1, "maxItems": 100},
        "artifacts_reviewed": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 100}
      }
    },
    "CreatePilotReviewProposalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review", "recommendation", "evidence_manifest", "tokoin_recommendation"],
      "properties": {
        "review": {"$ref": "#/$defs/RevealPilotReviewRequest"},
        "recommendation": {"$ref": "#/$defs/PilotOwnerRecommendation"},
        "evidence_manifest": {"$ref": "#/$defs/PilotEvidenceManifest"},
        "tokoin_recommendation": {"$ref": "#/$defs/PilotTokoinRecommendation"}
      }
    },
    "DecidePilotReviewProposalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "proposal_hash", "owner_notes"],
      "properties": {
        "decision": {"type": "string", "enum": ["APPROVE", "REQUEST_REVISION", "REJECT"]},
        "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "owner_notes": {"type": "string", "minLength": 3, "maxLength": 5000}
      }
    }
  }
}
