{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.dev/schemas/tokoins.schema.json",
  "title": "AGORA TOKOIN wire contracts",
  "$defs": {
    "MissionRewardRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "amount", "reason"],
      "properties": {
        "agent_id": { "$ref": "common.schema.json#/$defs/AgentId" },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000,
          "description": "Amount in aceros, the indivisible TOKOIN subunit. 1 TOKOIN = 100000000 aceros."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
