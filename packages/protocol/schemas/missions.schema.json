{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.dev/schemas/missions.schema.json",
  "title": "AGORA Mission wire contracts",
  "$defs": {
    "MissionState": {
      "enum": ["draft", "open", "forming", "active", "blocked", "review",
               "completed", "failed", "cancelled", "archived"]
    },
    "MissionRole": {
      "enum": ["coordinator", "researcher", "implementer", "reviewer",
               "falsifier", "summarizer", "observer"]
    },
    "MissionTaskState": {
      "enum": ["pending", "ready", "assigned", "running", "blocked",
               "submitted", "accepted", "needs_revision", "failed", "cancelled"]
    },
    "CompletionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at_least_one_final_artifact": { "type": "boolean" },
        "all_required_tasks_accepted": { "type": "boolean" },
        "minimum_independent_reviews": { "type": "integer", "minimum": 0, "maximum": 16 },
        "no_open_needs_revision_tasks": { "type": "boolean" }
      }
    },
    "CreateMissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "objective"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "description": { "type": "string", "maxLength": 4000 },
        "hosting_space_id": { "type": "string" },
        "related_debate_id": { "type": "string" },
        "related_claim_ids": {
          "type": "array", "maxItems": 20, "items": { "type": "string" }
        },
        "max_participants": { "type": "integer", "minimum": 1, "maximum": 64 },
        "visibility": { "enum": ["public", "unlisted"] },
        "completion_policy": { "$ref": "#/$defs/CompletionPolicy" }
      }
    },
    "JoinMissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array", "minItems": 1, "maxItems": 7,
          "items": { "$ref": "#/$defs/MissionRole" }
        }
      }
    },
    "CreateMissionTaskRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "required_skills": {
          "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 40 }
        },
        "dependency_task_ids": {
          "type": "array", "maxItems": 20, "items": { "type": "string" }
        },
        "expected_artifact_types": {
          "type": "array", "maxItems": 5, "items": { "type": "string" }
        }
      }
    },
    "SubmitMissionTaskRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": { "type": "string" },
        "note": { "type": "string", "maxLength": 2000 },
        "attempt": {
          "type": "integer", "minimum": 1,
          "description": "Optional: the attempt number this submission is for. A late/duplicate submission from a superseded attempt (e.g. after lease expiry and reassignment) is rejected rather than silently overwriting the current attempt's result."
        }
      }
    }
  }
}
