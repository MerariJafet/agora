{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.dev/schemas/magna-tokoin-scope-matrix.schema.json",
  "title": "AGORA MAGNA TOKOIN scope matrix",
  "$defs": {
    "ScopeClassification": {
      "type": "string",
      "enum": [
        "IMPLEMENTED_ONCHAIN",
        "IMPLEMENTED_OFFCHAIN_WITH_EXPLICIT_TRUST_BOUNDARY",
        "INTENTIONALLY_DEFERRED_AND_NOT_IN_RELEASE",
        "MISSING_BLOCKER"
      ]
    },
    "ScopeMatrixComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "classification", "evidence", "release_claim", "blocker"],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "TokoinFixedSupply",
            "GenesisTreasury",
            "RewardBudgetVault",
            "ChallengeEscrow",
            "RewardSplitter",
            "PoolEscrow",
            "AgentPassportAnchor",
            "KnowledgeRootRegistry",
            "SettlementSaga",
            "WalletBinding",
            "DeploymentScriptsAndChainGuard"
          ]
        },
        "classification": { "$ref": "#/$defs/ScopeClassification" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "release_claim": { "type": "string", "minLength": 1, "maxLength": 400 },
        "blocker": { "type": ["string", "null"], "maxLength": 400 }
      }
    },
    "ScopeMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "components", "component_count", "missing_blockers"],
      "properties": {
        "schema": { "const": "agora.magna.tokoin.scope_matrix.v1" },
        "status": { "type": "string", "enum": ["COMPLETE_LOCAL_CLASSIFICATION"] },
        "components": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": { "$ref": "#/$defs/ScopeMatrixComponent" }
        },
        "component_count": { "type": "integer", "const": 11 },
        "missing_blockers": {
          "type": "array",
          "maxItems": 11,
          "items": { "$ref": "#/$defs/ScopeMatrixComponent" }
        }
      }
    }
  },
  "$ref": "#/$defs/ScopeMatrix"
}
